---
export const partial = true;

import { z } from "astro/zod";
import Comments from "../../components/api/Comments.astro";
import { db } from "../..";
import { count, eq } from "drizzle-orm";
import { comment } from "../../db/schema";
import { assertRequest } from "../../utils";

const previousComments = await db
	.select({ count: count() })
	.from(comment)
	.where(eq(comment.author_ip, Astro.clientAddress))
	.limit(25)
	.then((x) => x[0].count);

if (previousComments > 0) return new Response(null, { status: 429 });

const args = await assertRequest(Astro.request, "POST", {
	author: z.string().trim().min(1).max(32),
	body: z.string().trim().min(1).max(256),
});

const returned = await db
	.insert(comment)
	.values({ author: args.author, body: args.body, author_ip: Astro.clientAddress })
	.returning({ author: comment.author, body: comment.body })
	.then((x) => x[0]);

if (!returned) return new Response(null, { status: 500, statusText: "Internal Server Error" });
---

<Comments />
